// Regression test for the SMT-session stderr deadlock.
//
// Synthetic on purpose: 320 trivial behaviours mean 320+ solver queries,
// each preceded by (reset). Before the fix, (reset) wiped the (set-logic ALL)
// preamble, so the solver emitted a warning block (~270 bytes with cvc5) per
// query onto a stderr pipe that nothing ever read. Past the pipe's capacity
// (as low as 8KB under pipe-buffer pressure, 64KB by default) the solver
// blocks in write(), act blocks in poll(), and act type hangs forever at
// zero CPU. This file generates ~86KB of pre-fix warning volume - past any
// kernel's pipe capacity. Post-fix (stderr drained + preamble re-sent after
// every reset) it must simply typecheck to completion.

contract StressSmtSession

constructor()

creates

  uint256 acc := 0

transition probe0(uint256 x) : uint256

iff

  inRange(uint256, x + 1)

updates

returns x + 1


transition probe1(uint256 x) : uint256

iff

  inRange(uint256, x + 2)

updates

returns x + 2


transition probe2(uint256 x) : uint256

iff

  inRange(uint256, x + 3)

updates

returns x + 3


transition probe3(uint256 x) : uint256

iff

  inRange(uint256, x + 4)

updates

returns x + 4


